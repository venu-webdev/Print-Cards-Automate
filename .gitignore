templates/*_reference.png
templates/*.local.json

# big installers - download from Epson instead
Printer-Resources/

# python / editor junk
__pycache__/
*.pyc
.venv/
venv/
.vscode/
.idea/
Thumbs.db
desktop.ini

# per-PC plugin settings (printer choices) - each PC keeps its own
plugins/*/config.json
